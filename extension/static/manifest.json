{
  "manifest_version": 3,
  "name": "Top of the Stack LinkedIn Capture",
  "version": "0.1.0",
  "description": "Saves the people on LinkedIn searches opened from Top of the Stack into your local Top of the Stack server.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
