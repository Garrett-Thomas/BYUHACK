# Required for /api/find-contact and /api/draft-email
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Listen port (the server binds to 127.0.0.1 only)
PORT=3001
# SQLite file, resolved relative to server/. Created on first start.
DATABASE_PATH=./data/warmline.db
# Comma-separated CORS origins; chrome-extension:// origins are always allowed
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
